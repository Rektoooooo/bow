<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- http and https: macOS sends the app web links. With the HTML documents below, this is what makes macOS list
       it as a web browser (System Settings › Desktop & Dock › Default web browser). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web site URL</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
    <!-- bow:// lets other apps drive Bow: Raycast, Alfred, Shortcuts (src/main/bowUrls.ts). -->
    <dict>
      <key>CFBundleURLName</key>
      <string>Bow command</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>bow</string>
      </array>
    </dict>
  </array>
  <!-- HTML pages on disk. macOS counts an app as a web browser only when it opens these as well as web links (other
       browsers declare the same); Finder then also offers Bow for .html files (main.ts open-file). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>HTML document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.html</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>XHTML document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.xhtml</string>
      </array>
    </dict>
  </array>
  <!-- macOS shows these when a site you allowed first uses the camera, microphone or location. -->
  <key>NSCameraUsageDescription</key>
  <string>Websites you allow can use the camera, for example for video calls.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Websites you allow can use the microphone, for example for calls.</string>
  <key>NSLocationUsageDescription</key>
  <string>Websites you allow can see your location, for example maps.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Websites you allow can see your location, for example maps.</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <key>NSHumanReadableCopyright</key>
  <string>Bow contributors</string>
</dict>
</plist>
