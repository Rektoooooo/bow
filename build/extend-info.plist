<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- http and https: this is what makes macOS list the app as a web browser and send it links. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Web site URL</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>http</string>
        <string>https</string>
      </array>
    </dict>
  </array>
  <!-- macOS shows these when a site you allowed first uses the camera, microphone or location. -->
  <key>NSCameraUsageDescription</key>
  <string>Websites you allow can use the camera, for example for video calls.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Websites you allow can use the microphone, for example for calls.</string>
  <key>NSLocationUsageDescription</key>
  <string>Websites you allow can see your location, for example maps.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Websites you allow can see your location, for example maps.</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <key>NSHumanReadableCopyright</key>
  <string>Sidebar Browser contributors</string>
</dict>
</plist>
